{
  "name": "wizard-duel-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wizard Duel - 2-player online multiplayer, based on ruichen199801/wizard-duel",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start:server": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "test:sync": "node scripts/sync-test.mjs",
    "test:win": "node scripts/win-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "bootstrap": "^5.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
